{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build"
  },
  "deploy": {
    "startCommand": "npm run start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "volumes": [
      {
        "mountPath": "/data",
        "name": "sqlite-data"
      }
    ],
    "env": {
      "DATABASE_PATH": "/data/clutch.db"
    }
  }
}

{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "services": {
    "clutch-api": {
      "source": {
        "root": "api"
      },
      "build": {
        "buildCommand": "npm install && npm run build"
      },
      "deploy": {
        "startCommand": "npm run start",
        "healthcheckPath": "/api/users",
        "volumes": [
          {
            "mountPath": "/data",
            "name": "sqlite-data"
          }
        ],
        "env": {
          "DATABASE_PATH": "/data/clutch.db"
        }
      }
    },
    "clutch-front": {
      "source": {
        "root": "front"
      },
      "build": {
        "buildCommand": "npm install && npm run build:staging"
      },
      "deploy": {
        "startCommand": "npx serve -s dist -l $PORT"
      }
    }
  }
}
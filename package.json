{
  "name": "clutch-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=api\" \"npm run dev --workspace=front\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:front": "npm run dev --workspace=front",
    "build": "concurrently \"npm run build --workspace=api\" \"npm run build --workspace=front\"",
    "build:staging": "concurrently \"npm run build --workspace=api\" \"npm run build:staging --workspace=front\"",
    "build:prod": "concurrently \"npm run build --workspace=api\" \"npm run build:prod --workspace=front\"",
    "start": "node -e \"require('child_process').spawn('npm', ['start'], {cwd: 'api', stdio: 'inherit', shell: true})\"",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "workspaces": [
    "api",
    "front"
  ],
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
